# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional analytics (client). Loaded only after cookie consent.
# VITE_GA4_ID=G-XXXXXXXXXX

# Contact API (Worker / Pages Function secrets — set in Cloudflare, not in Vite)
# CONTACT_TO=you@example.com
# CONTACT_FROM=no-reply@yourdomain.com
# CONTACT_SUBJECT_PREFIX=Danco Analytics
